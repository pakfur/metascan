# ============================================================
# Project-specific
# ============================================================

# Runtime data — ignore everything under data/ except the
# vocabulary directory (tracked CLIP tag axes), the
# meta-prompt YAML (source-of-truth for VLM prompts; loaded by
# metascan/core/prompt_store.py and hot-reloaded at runtime),
# and the prompt guides (format documentation for video compilers).
data/*
!data/vocabulary/
!data/meta_prompt.yml
!data/prompt_guides/
!data/workflows/
!data/templates/
!data/i2v_templates/
# T2I: the starter lists and characters.yml are tracked; the caption CSV
# (tens of MB, user-supplied) is not.
!data/t2i_captions/
data/t2i_captions/*.csv

.claude/*
!.claude/rules/

# Other runtime artifacts
logs/
# Anchored so it only matches the root-level cache dir, not
# frontend/src/components/thumbnails/.
/thumbnails/
models/
gfpgan/
assets/media/
data/vocabulary/*.npz

# Local config (config_example.json is tracked)
config.json
config_dist.json

# AI agent scratch
WARP.md
docs/wireframes/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
venv-*/
ENV/

# Tooling caches
.mypy_cache/
.dmypy.json
.pytest_cache/
.coverage
.coverage.*
.hypothesis/
htmlcov/
coverage.xml

# ============================================================
# Editors / IDEs
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# OS
# ============================================================
.DS_Store
._*
Thumbs.db
ehthumbs.db

# ============================================================
# Temporary
# ============================================================
*.tmp
*.temp
*.log
temp/
.worktrees/
